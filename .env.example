# Copy to .env and fill in. .env is gitignored; this file documents every key.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Required: PostgreSQL 16 with pgvector (README.md, "Native setup").
DATABASE_URL=postgres://USER@127.0.0.1:5432/super_notes

# Redis, for Celery. Separate databases for the queue and the results.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Production: a shared cache, so the rate limits count across workers.
# CACHE_URL=rediscache://127.0.0.1:6379/2

# The Vite dev server, so the web client can call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Sign in with Google: every OAuth client id to accept (web, Android),
# comma-separated. Empty turns sign-in off.
GOOGLE_OAUTH_CLIENT_IDS=

# Embeddings (docs/RAG.md). "fake" needs no key and no network; set openai
# or gemini and that vendor's key to index for real. The dimension is fixed
# by the chunk table's migration: changing it, or the model, means a
# migration and a full re-index (DECISIONS D36).
# EMBEDDING_PROVIDER=fake
# EMBEDDING_OPENAI_MODEL=text-embedding-3-small
# EMBEDDING_GEMINI_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_BATCH_SIZE=64
# Each vendor's own key variable. Only the chosen provider's is needed.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Set to 1 (with a key above) to run the paid live provider tests (D40).
# LIVE_PROVIDER_TESTS=0

# Chunk sizes in characters, ~4 per token (DECISIONS D33).
# CHUNK_TARGET_CHARS=1600
# CHUNK_MAX_CHARS=2000
# CHUNK_OVERLAP_CHARS=200
# Seconds a note write waits before it is indexed (autosave debounce).
# INDEX_DEBOUNCE_SECONDS=20

# Optional
# ADMIN_URL=admin/
# LOG_LEVEL=INFO
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=14
# SECURE_HSTS_SECONDS=3600
# USE_X_FORWARDED_PROTO=False
# ADMINS=Name:you@example.com

# Ask your notes: the chat provider. "fake" (the default) needs no key and
# no network; the tests always use it. Real ones: claude, openai, gemini.
# CHAT_PROVIDER=fake
# CHAT_CLAUDE_MODEL=claude-haiku-4-5
# CHAT_OPENAI_MODEL=gpt-5-mini
# CHAT_GEMINI_MODEL=gemini-2.5-flash-lite
# CHAT_MAX_OUTPUT_TOKENS=2048
# CHAT_TIMEOUT_SECONDS=60
# Each provider reads its vendor's usual key. Setting one also turns on that
# provider's live test (one tiny paid call per test run).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ASK_RETRIEVAL_K=8
# ASK_RELEVANCE_FLOOR=0.0
# ASK_EXCERPT_MAX_CHARS=12000
# ASK_NO_ANSWER_TEXT=I couldn't find anything in your notes about this.
# Conversations: earlier turns repeated in a turn's prompt, and condensing.
# CHAT_HISTORY_MAX_CHARS=6000
# CHAT_CONDENSE_HISTORY_MAX_CHARS=2000
# CHAT_CONDENSE_MAX_OUTPUT_TOKENS=512

# Format my note (D240-D249): the guardrail's thresholds (share of the original's words kept,
# share of the result's words that were in the original), the longest note it will format
# (characters of its JSON), the output ceiling, and when an unfinished job is failed.
# FORMAT_MIN_WORDS_KEPT=0.9
# FORMAT_MIN_WORDS_ORIGINAL=0.8
# FORMAT_MAX_INPUT_CHARS=24000
# FORMAT_MAX_OUTPUT_TOKENS=16384
# FORMAT_STUCK_AFTER_SECONDS=3600
# API_FORMAT_THROTTLE=30/hour

# Devices an account may be signed in on at once; a further sign-in ends the oldest.
# MAX_SIGNED_IN_DEVICES=2
# Days a security event is kept before the daily purge removes it.
# SECURITY_EVENT_RETENTION_DAYS=365

# App lifecycle (D90-D94). Build ids are YYYYMMDDHHMM-<shortsha>; empty announces nothing.
# CLIENT_LATEST_VERSION=
# CLIENT_MIN_VERSION=
# Memory notice every this many app opens since the user last saw it.
# MEMORY_NOTICE_EVERY_OPENS=5
# A second app open from one device inside this window is not counted.
# APP_OPEN_MIN_INTERVAL_SECONDS=300
