# Copy to .env and fill in. .env is gitignored; this file documents every key.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Required: PostgreSQL 16 with pgvector (README.md, "Native setup").
DATABASE_URL=postgres://USER@127.0.0.1:5432/super_notes

# Redis, for Celery. Separate databases for the queue and the results.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Production: a shared cache, so the rate limits count across workers.
# CACHE_URL=rediscache://127.0.0.1:6379/2

# The Vite dev server, so the web client can call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Sign in with Google: every OAuth client id to accept (web, Android),
# comma-separated. Empty turns sign-in off.
GOOGLE_OAUTH_CLIENT_IDS=

# Optional
# ADMIN_URL=admin/
# LOG_LEVEL=INFO
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=14
# SECURE_HSTS_SECONDS=3600
# USE_X_FORWARDED_PROTO=False
# ADMINS=Name:you@example.com

# Ask your notes: the chat provider. "fake" (the default) needs no key and
# no network; the tests always use it. Real ones: claude, openai, gemini.
# CHAT_PROVIDER=fake
# CHAT_CLAUDE_MODEL=claude-haiku-4-5
# CHAT_OPENAI_MODEL=gpt-5-mini
# CHAT_GEMINI_MODEL=gemini-2.5-flash-lite
# CHAT_MAX_OUTPUT_TOKENS=2048
# CHAT_TIMEOUT_SECONDS=60
# Each provider reads its vendor's usual key. Setting one also turns on that
# provider's live test (one tiny paid call per test run).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ASK_RETRIEVAL_K=8
# ASK_RELEVANCE_FLOOR=0.0
# ASK_EXCERPT_MAX_CHARS=12000
# ASK_NO_ANSWER_TEXT=I couldn't find anything in your notes about this.
