# Copy to web/.env.local (gitignored) and fill in.

# The API, including the version prefix. Default: http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# The OAuth 2.0 *web* client id from Google Cloud Console. It must also be in
# the backend's GOOGLE_OAUTH_CLIENT_IDS, and http://localhost:5173 must be an
# authorised JavaScript origin on it.
VITE_GOOGLE_CLIENT_ID=
